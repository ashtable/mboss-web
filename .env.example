# mboss-web — local environment.
# Copy to .env.local and adjust. The compose stack
# passes these in directly and needs no file.

# The private API, reachable only inside the
# network. No trailing slash is needed; one is
# stripped if present.
API_BASE_URL=http://localhost:3001

# The bearer this app sends on every /v1/ call.
# Must match the API's value.
WEB_SERVICE_TOKEN=dev-web-service-token

# The public origin, used for canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
