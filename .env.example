# mboss-web — local environment.
# Copy to .env.local and adjust. The superproject's
# docker compose stack reads that same file, so it is
# the one place to change any of these; the only value
# compose sets itself is API_BASE_URL, which in there
# has to name the compose network's api.

# The private API, reachable only inside the
# network. No trailing slash is needed; one is
# stripped if present.
API_BASE_URL=http://localhost:3001

# The bearer this app sends on every /v1/ call.
# Must match the API's value.
WEB_SERVICE_TOKEN=dev-web-service-token

# The public origin, used for canonical links. Not
# the same thing as SITE_URL in
# mboss-nodejs-dbos/.env: that one is the worker's,
# and only the worker builds the links it mails out
# from it, while this one is web's own public
# origin. The NEXT_PUBLIC_ prefix is what ships a
# value to the browser; SITE_URL never leaves the
# worker.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js refuses every request under NODE_ENV=
# production unless it is told which origin it is
# serving, and this deploy is not somewhere it can
# work that out for itself. Its path is the auth base
# path, which on Next is /api/auth.
AUTH_URL=http://localhost:3000/api/auth

# The admin sign-in. The issuer must name one tenant
# GUID: Entra does not verify the email claim across
# tenants, so `common` or `organizations` would admit
# accounts an attacker controls. Nothing else parses.
#
# AUTH_SECRET has no value here to copy. `next dev`
# on this machine would take any string, but the
# container serves a production build, and
# src/env.ts refuses a secret under 32 characters
# or equal to the readable `dev-auth-secret`
# default — the one guard standing between a
# deploy and a console anyone who has read this
# repository can sign in to. An example file is
# public by definition, so filling this in would
# hand that guard a second value it has to know
# about and does not. Generate your own:
#
#   openssl rand -hex 32
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=dev-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=dev-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/00000000-0000-4000-8000-000000000000/v2.0
ADMIN_ALLOWED_DOMAIN=autoretryai.com
